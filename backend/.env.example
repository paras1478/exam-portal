# Runtime environment: development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_portal?schema=public

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN_HOURS=8

# Comma-separated list of allowed frontend origins (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend (used in email links)
APP_URL=http://localhost:5173

# SMTP (optional). When SMTP_HOST is empty, emails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ExamFlow <no-reply@examflow.local>"

# Seconds of tolerance after the deadline for in-flight autosave requests
SUBMISSION_GRACE_SECONDS=10

# Number of reverse proxies in front of the API (e.g. 1 behind nginx). 0 = none.
TRUST_PROXY=0

# One-time first-admin bootstrap (npm run create-admin). Optional: you can pass --email/--name instead
# and type the password at a hidden prompt. Remove these values after the first admin exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
